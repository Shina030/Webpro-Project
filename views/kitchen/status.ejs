<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>สถานะรายการอาหาร - ครัว</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="kitchen-page">
  <header class="topbar">
    <div aria-hidden="true"></div>
    <div class="kitchen-waiting">รอดำเนินการ <span id="waiting-count"><%= orders.length %></span></div>
    <nav class="kitchen-nav"><a href="/kitchen/orders">หน้าหลัก</a><a class="active" href="/kitchen/status">สถานะ</a></nav>
  </header>

  <main class="container status-container">
    <h1 class="screen-title">อัปเดตสถานะรายการอาหาร</h1>
    <div class="no-order" id="no-order" style="<%= orders.length ? 'display:none' : '' %>">ไม่มีออเดอร์ที่กำลังเตรียม</div>
    <div class="order-list" id="order-list"></div>
  </main>

  <div class="kitchen-clock"><div id="clockDate"></div><strong id="clockTime"></strong></div>

<script>
const initialOrders = <%- JSON.stringify(orders).replace(/</g, '\\u003c') %>;
let updatingOrderId = null;
let lastSignature = '';

function escapeHtml(value){
  return String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
}

function orderSignature(orders){
  return JSON.stringify(orders.map(order => [order.Order_Id, order.Order_Status, order.items.map(item => [item.Menu_Name,item.Quantity])]));
}

function orderCardHtml(order){
  const items = order.items.map((item,index) => `
    <div class="menu-item">
      <span class="item-index">${index+1}</span>
      <span class="quantity">${escapeHtml(item.Quantity)}</span>
      <span class="menu-name">${escapeHtml(item.Menu_Name)}</span>
    </div>`).join('');

  return `
    <article class="order-card status-card" id="order-${order.Order_Id}" data-order-id="${order.Order_Id}">
      <div class="order-header">
        <span class="order-id">${String(order.Order_Id).padStart(4,'0')}</span>
        <span class="table-number">${escapeHtml(order.Table_Number)}</span>
      </div>
      <div class="order-body">
        <p class="order-meta"><span>ลูกค้า: <strong>${escapeHtml(order.Customer_Name)}</strong></span><span>${escapeHtml(order.Order_Time)}</span></p>
        <div class="menu-list">${items}</div>
      </div>
      <button type="button" class="update-button" onclick="finishOrder(${order.Order_Id})">อัปเดต • เสร็จแล้ว</button>
    </article>`;
}

function renderOrders(orders, force=false){
  const signature = orderSignature(orders);
  if (!force && signature === lastSignature) return;
  if (updatingOrderId) return;

  lastSignature = signature;
  document.getElementById('waiting-count').textContent = orders.length;
  document.getElementById('no-order').style.display = orders.length ? 'none' : 'block';
  document.getElementById('order-list').innerHTML = orders.map(orderCardHtml).join('');
}

async function refreshOrders(){
  if (updatingOrderId) return;
  try {
    const response = await fetch('/kitchen/api/orders?view=status', { cache:'no-store' });
    const data = await response.json();
    if (response.ok && data.ok) renderOrders(data.orders);
  } catch (error) {}
}

async function finishOrder(orderId){
  if (updatingOrderId) return;
  updatingOrderId = orderId;
  const card = document.getElementById(`order-${orderId}`);
  const button = card?.querySelector('.update-button');
  if (button) { button.disabled = true; button.textContent = 'กำลังอัปเดต...'; }

  try {
    const response = await fetch(`/kitchen/orders/${orderId}/update`, {
      method:'POST',
      headers:{'Accept':'application/json'}
    });
    const data = await response.json();
    if (!response.ok || !data.ok) throw new Error(data.message || 'อัปเดตสถานะไม่สำเร็จ');

    if (card) {
      card.classList.add('order-leaving');
      setTimeout(() => {
        card.remove();
        const remaining = document.querySelectorAll('#order-list .order-card').length;
        document.getElementById('waiting-count').textContent = remaining;
        document.getElementById('no-order').style.display = remaining ? 'none' : 'block';
        updatingOrderId = null;
        lastSignature = '';
        refreshOrders();
      }, 180);
    } else {
      updatingOrderId = null;
      refreshOrders();
    }
  } catch (error) {
    updatingOrderId = null;
    if (button) { button.disabled = false; button.textContent = 'อัปเดต • เสร็จแล้ว'; }
    alert(error.message);
  }
}

function updateClock(){
  const now = new Date();
  document.getElementById('clockDate').textContent = now.toLocaleDateString('th-TH', {day:'2-digit',month:'2-digit',year:'numeric'});
  document.getElementById('clockTime').textContent = now.toLocaleTimeString('th-TH', {hour:'2-digit',minute:'2-digit',second:'2-digit'});
}

renderOrders(initialOrders, true);
updateClock();
setInterval(updateClock, 1000);
setInterval(refreshOrders, 1800);
</script>
</body>
</html>
