<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>เมนูอาหาร</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="mobile-frame">
    <div class="customer-topline">
      <div><strong>โต๊ะ <%= tableNumber %></strong><span class="user-greeting">สวัสดี, <%= username %></span></div>
      <div class="customer-nav"><a href="/customer/history">ประวัติ</a></div>
    </div>

    <div class="header-user">
      <select name="category" id="category-select" class="category-dropdown" onchange="filterCategory()">
        <option value="all">เมนูทั้งหมด</option>
        <option value="sushi-sashimi">ซูชิและซาซิมิ</option>
        <option value="rice">ข้าว</option>
        <option value="teppanyaki">เทปันยากิ</option>
        <option value="tonkatsu">ทงคัตซึ</option>
        <option value="ramen">ราเมน</option>
        <option value="appetizer">ของทานเล่น</option>
        <option value="salad">สลัด</option>
        <option value="dessert">ของหวาน</option>
        <option value="drink">เครื่องดื่ม</option>
      </select>
    </div>

    <div class="menu-grid" id="menu-grid">
      <% items.forEach(function(item) { %>
        <div class="menu-card" data-id="<%= item.id %>">
          <div class="img-container">
            <a href="/customer/menu/<%= item.id %>">
              <img src="/menu_pic/<%= item.pimage %>.png" alt="<%= item.name %>" class="menu-img">
            </a>
            <form action="/customer/cart/add" method="POST" class="add-form">
              <input type="hidden" name="menu_id" value="<%= item.id %>">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="plus-btn" aria-label="เพิ่ม <%= item.name %> ลงตะกร้า">+</button>
            </form>
          </div>
          <div class="item-info">
            <div class="item-title"><%= item.name %></div>
            <div class="price"><%= Number(item.price).toFixed(2) %> ฿</div>
          </div>
        </div>
      <% }); %>
    </div>

    <div id="cart-bar" class="cart-bar" style="<%= cartCount > 0 ? '' : 'display:none' %>">
      <div class="cart-info">ตะกร้าของคุณ (<span id="cart-count"><%= cartCount %></span> รายการ)</div>
      <a href="/customer/cart" class="view-cart-btn">ดูตะกร้า</a>
    </div>

    <div class="cart-toast" id="cart-toast" aria-live="polite">เพิ่มลงตะกร้าแล้ว</div>
  </div>
<script>
function filterCategory(){
  const value = document.getElementById('category-select').value;
  document.querySelectorAll('.menu-card').forEach(card => {
    const id = card.dataset.id;
    let show = value === 'all';
    if (value === 'sushi-sashimi') show = /^A(0[1-9]|1[0-6])$/.test(id);
    if (value === 'rice') show = /^B(0[1-9]|1[0-2])$/.test(id);
    if (value === 'teppanyaki') show = /^C0[1-4]$/.test(id);
    if (value === 'tonkatsu') show = /^D0[1-3]$/.test(id);
    if (value === 'ramen') show = /^E0[1-8]$/.test(id) || /^F0[1-3]$/.test(id);
    if (value === 'appetizer') show = /^G0[1-8]$/.test(id);
    if (value === 'salad') show = /^H0[1-5]$/.test(id);
    if (value === 'dessert') show = /^I0[1-8]$/.test(id);
    if (value === 'drink') show = /^J0[1-5]$/.test(id);
    card.style.display = show ? 'flex' : 'none';
  });
}

let toastTimer;
function showCartToast(name){
  const toast = document.getElementById('cart-toast');
  toast.textContent = name ? `เพิ่ม ${name} ลงตะกร้าแล้ว` : 'เพิ่มลงตะกร้าแล้ว';
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove('show'), 1200);
}

document.querySelectorAll('.add-form').forEach(form => {
  form.addEventListener('submit', async event => {
    event.preventDefault();
    const button = form.querySelector('.plus-btn');
    if (button.disabled) return;

    button.disabled = true;
    const oldText = button.textContent;
    button.textContent = '✓';

    try {
      const body = new URLSearchParams(new FormData(form));
      const response = await fetch(form.action, {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
        },
        body
      });
      const data = await response.json();
      if (!response.ok || !data.ok) throw new Error(data.message || 'เพิ่มรายการไม่สำเร็จ');

      document.getElementById('cart-count').textContent = data.cartCount;
      document.getElementById('cart-bar').style.display = 'flex';
      showCartToast(data.item?.name);
    } catch (error) {
      alert(error.message);
      button.textContent = oldText;
    } finally {
      setTimeout(() => {
        button.textContent = oldText;
        button.disabled = false;
      }, 450);
    }
  });
});
</script>
</body>
</html>
