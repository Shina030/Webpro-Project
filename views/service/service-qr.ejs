<!DOCTYPE html><html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Print QR Code</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:'Sarabun','TH Sarabun New',Tahoma,sans-serif;background:#f7f8fc;color:#171a2b}.topbar{height:72px;margin:18px 22px;background:linear-gradient(90deg,#6964ee,#817cef);border-radius:10px;display:flex;align-items:center;justify-content:space-between;padding:0 26px;color:#fff}.brand{font-size:22px;font-weight:700}.nav{display:flex;gap:18px}.page{margin:28px 40px}.back{color:#171a2b;text-decoration:none;font-size:20px;font-weight:700}.grid{display:grid;grid-template-columns:repeat(6,1fr);gap:18px;margin-top:25px}.card{height:125px;border:0;border-radius:8px;box-shadow:0 7px 14px #c8cad2;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:16px;transition:background .25s,transform .15s}.card strong{font-size:20px;margin-bottom:14px}.AVAILABLE{background:#e2e5eb;cursor:pointer}.OCCUPIED{background:#ff646b;cursor:pointer}.AVAILABLE:hover,.OCCUPIED:hover{transform:translateY(-2px)}.CLEANING{background:#ffd6a7;color:#7a552e;cursor:not-allowed}.legend{display:flex;gap:25px;margin-top:35px}.dot{width:15px;height:15px;border-radius:50%;display:inline-block;margin-right:7px}.d1{background:#aeb5c1}.d2{background:#ff535b}.d3{background:#ffa63e}.modal-bg{display:none;position:fixed;inset:0;background:#0009;align-items:center;justify-content:center;z-index:1000}.modal{width:430px;background:white;border-radius:15px;padding:24px;text-align:center}.modal h2{font-size:28px;border-bottom:1px solid #ddd;padding-bottom:15px;margin:0}.modal img{width:230px;height:230px;margin:10px}.url{font-size:12px;word-break:break-all}.actions{display:flex;gap:15px;margin-top:22px}.actions button{flex:1;border:0;border-radius:8px;padding:13px;color:#fff;font-size:17px;font-weight:700}.cancel{background:#e3202a}.print{background:#00a85a}@media(max-width:900px){.grid{grid-template-columns:repeat(3,1fr)}}
@media print{@page{size:80mm 120mm;margin:0}body{background:#fff}body *{visibility:hidden}.modal,.modal *{visibility:visible}.modal{position:absolute;left:4mm;top:0;transform:none;width:72mm;padding:4mm 3mm;border-radius:0;box-shadow:none}.modal h2{font-size:20px;padding-bottom:3mm}.modal p{font-size:12px;margin:2mm 0}.modal img{width:50mm;height:50mm;margin:3mm auto}.url{font-size:8px;line-height:1.25}.actions{display:none}.modal-bg{background:white}}
</style>
  <link rel="stylesheet" href="/styles.css">
</head><body><div class="topbar"><div class="brand">Japanese Restaurant</div><div class="nav"><span>Service Staff</span><span>|</span><span>Logout</span></div></div>
<main class="page"><a class="back" href="/service/tables">← &nbsp;เลือกโต๊ะสำหรับพิมพ์ QR Code</a><div class="grid" id="qrGrid"></div><div class="legend"><span><i class="dot d1"></i>ว่าง</span><span><i class="dot d2"></i>ไม่ว่าง</span><span><i class="dot d3"></i>รอทำความสะอาด (ไม่สามารถพิมพ์ได้)</span></div></main>
<div class="modal-bg" id="qrModal"><div class="modal"><h2 id="qrTitle">A1</h2><p>โต๊ะ : <b id="qrTable">A1</b></p><img id="qrImage"><div class="url" id="qrUrl"></div><p>สแกนเพื่อเข้าสู่ระบบ</p><div class="actions"><button class="cancel" onclick="closeQR()">ยกเลิก</button><button class="print" onclick="printQR()">พิมพ์</button></div></div></div>
<script>
const initialTables=<%- JSON.stringify(tables).replace(/</g,'\\u003c') %>;
let currentId=null,currentToken=null;
function statusText(s){return s==='AVAILABLE'?'ว่าง':s==='OCCUPIED'?'ไม่ว่าง':'🚫 ไม่สามารถพิมพ์ได้'}
function renderQrTables(tables){document.getElementById('qrGrid').innerHTML=tables.map(t=>`<button class="card ${t.table_status}" ${t.table_status==='CLEANING'?'disabled':`onclick="showQR(${t.table_id})"`}><strong>${t.table_number}</strong><span>${statusText(t.table_status)}</span>${t.table_status==='CLEANING'?'<small>(รอทำความสะอาด)</small>':''}</button>`).join('')}
renderQrTables(initialTables);
async function refreshQrTables(){try{const r=await fetch('/service/api/tables',{cache:'no-store'});const d=await r.json();if(r.ok&&d.ok)renderQrTables(d.tables)}catch(e){}}
setInterval(refreshQrTables,1200);
async function showQR(id){const r=await fetch('/service/qr/'+id,{cache:'no-store'});const d=await r.json();if(!r.ok){alert(d.error);return}currentId=id;currentToken=d.token;qrTitle.textContent=d.table.table_number;qrTable.textContent=d.table.table_number;qrImage.src=d.qrData;qrUrl.textContent=d.url;qrModal.style.display='flex'}
function closeQR(){qrModal.style.display='none'}
function setQrPaperSize(){const modal=document.querySelector('#qrModal .modal');if(!modal)return;const heightMm=Math.max(100,Math.ceil((modal.scrollHeight*25.4/96)+8));let style=document.getElementById('qrPaperStyle');if(!style){style=document.createElement('style');style.id='qrPaperStyle';document.head.appendChild(style)}style.textContent=`@media print{@page{size:80mm ${heightMm}mm;margin:0}}`}
async function printQR(){const r=await fetch('/service/qr/'+currentId+'/print',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:currentToken})});const d=await r.json();if(!r.ok){alert(d.error);return}currentToken=d.token;qrImage.src=d.qrData;qrUrl.textContent=d.url;await refreshQrTables();setQrPaperSize();setTimeout(()=>window.print(),150)}
qrModal.addEventListener('click',e=>{if(e.target.id==='qrModal')closeQR()})
</script></body></html>
