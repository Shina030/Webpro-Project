<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>รายการที่เลือกไว้</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="mobile-frame">
        <div class="cart-header">
            <a href="/menu" class="back-btn">&larr;</a>
            <h3>รายการที่เลือกไว้</h3>
        </div>

        <div class="cart-list">
            <% if (cart.length===0) { %>
                <p class="empty-msg">ยังไม่มีรายการในตะกร้า</p>
                <% } else { %>
                    <% cart.forEach(item=> { %>
                        <div class="cart-row">
                            <span class="item-name">
                                <%= item.name %>
                            </span>
                            <span class="item-price">
                                <%= item.price * item.quantity %> ฿
                            </span>
                            <div class="qty-controls">
                                <form action="/cart/update" method="POST" style="display:inline;">
                                    <input type="hidden" name="id" value="<%= item.id %>">
                                    <input type="hidden" name="action" value="decrease">
                                    <button type="submit">-</button>
                                </form>
                                <span>
                                    <%= item.quantity %>
                                </span>
                                <form action="/cart/update" method="POST" style="display:inline;">
                                    <input type="hidden" name="id" value="<%= item.id %>">
                                    <input type="hidden" name="action" value="increase">
                                    <button type="submit">+</button>
                                </form>
                            </div>
                        </div>
                        <% }) %>
                            <% } %>
        </div>

        <div class="checkout-footer">
            <div class="total-bar">
                <span>ยอดรวม</span>
                <span>
                    <%= total.toFixed(2) %> ฿
                </span>
            </div>
            <div class="action-buttons">
                <a href="/menu" class="btn-outline">+ สั่งอาหารเพิ่ม</a>
                <form action="/order/checkout" method="POST">
                    <button type="submit" class="btn-green" <%=cart.length===0 ? 'disabled' : ''
                        %>>ยืนยันสั่งอาหาร</button>
                </form>
                <a href="/history" class="btn-outline">ดูประวัติการสั่งซื้อ</a>
            </div>
        </div>
    </div>
</body>

</html>x